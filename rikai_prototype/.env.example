# Supported providers: openai | groq | openrouter | anthropic
API_PROVIDER=openai
AI_MODE=auto

# Model corresponding to the selected provider
MODEL=gpt-4o-mini

# Set only the API key corresponding to API_PROVIDER.
OPENAI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
ANTHROPIC_API_KEY=

# Qdrant - CHƯA sử dụng ở giai đoạn này (stub), để trống cũng chạy được
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_COLLECTION=rikai_standards
